{
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "noEmit": true,
        "noImplicitAny": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2024",
        "types": ["node", "vscode"]
    },
    "include": ["src/**/*.ts", "vite.config.ts"]
}
